# DataForge engine socket — systemd user unit
# Install to: ~/.config/systemd/user/dataforge.socket
# Enable:     systemctl --user enable --now dataforge.socket
# Status:     systemctl --user status dataforge.socket
#
# Socket activation: systemd starts dataforge.service on first connect.
# The engine listens on a Unix Domain Socket at $XDG_RUNTIME_DIR/dataforge/engine.sock.
# Socket permissions 0700 ensure only the owning user can connect.
#
# See: docs/proposals/NATIVE_OS_API_REVIEW.md §3.2
# See: docs/proposals/INSTALL_UPGRADE_LIFECYCLE.md §3.2

[Unit]
Description=DataForge Engine Socket
Documentation=https://github.com/AztlanLabs/DataForge
PartOf=dataforge.service

[Socket]
ListenStream=%t/dataforge/engine.sock
SocketMode=0700
BindIPv6Only=both

[Install]
WantedBy=sockets.target
